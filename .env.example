# === データベース ===
# ローカル開発: SQLite (自動)
# 本番環境: Render PostgreSQL (自動)
# DATABASE_URL=postgresql://user:password@host:5432/db

# === Claude API (必須) ===
# 取得方法: https://console.anthropic.com/account/keys
CLAUDE_API_KEY=sk-...

# === SNS APIs (オプション) ===
# Note: https://note.com/api/v1/docs
NOTE_API_KEY=

# Twitter: https://developer.twitter.com/
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# === Flask ===
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production

# === スケジューラー ===
# 毎日この時刻に自動投稿 (24時間形式)
POST_TIME=09:00
SCHEDULER_TIMEZONE=Asia/Tokyo

